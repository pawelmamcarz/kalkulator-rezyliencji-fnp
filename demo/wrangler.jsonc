{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fnp-mapa-milczenia",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  // Request metadata only; the worker never logs answer text.
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Route runs before the calculator's custom domain on the same host.
  "routes": [{ "pattern": "fnp.silence-tax.com/rotunda*", "zone_name": "silence-tax.com" }],
  "workers_dev": false,
  // Rotunda entries: judgments, and quote text only with consent until moderated.
  // Replace database_id with the id printed by `wrangler d1 create fnp-rotunda`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fnp-rotunda",
      "database_id": "0ebfd6d4-d62a-4423-9fa0-4b6eec8ab186",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets: TYPESAFE_API_KEY, DEMO_CODE, MOD_CODE (wrangler secret put).
}
