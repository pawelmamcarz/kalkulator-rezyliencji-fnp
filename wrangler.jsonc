{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalkulator-rezyliencji-fnp",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "fnp.silence-tax.com",
      "custom_domain": true
    }
  ]
}
